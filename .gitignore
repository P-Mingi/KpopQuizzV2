# production
build/
# ...but NOT source route folders literally named build/ under the app dir. The rule
# above is for build OUTPUT; the Verse builder routes ((builder)/build the canvas, and
# verse/[slug]/build the shell) are real SOURCE routes, so re-include any build/ dir
# that lives under src/app/ (covers both and any future builder route).
!apps/quiz/src/app/**/build/
!apps/quiz/src/app/**/build/**

