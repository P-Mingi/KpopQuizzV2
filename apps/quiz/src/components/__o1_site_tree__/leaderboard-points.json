["$","section",null,{"className":"ux-sec p9-how","aria-labelledby":"p9-how-h","children":[["$","h2",null,{"className":"ux-h2 p9-how-h","id":"p9-how-h","children":"How points work"}],["$","details",null,{"className":"p9-acc","children":[["$","summary",null,{"children":["Fandom war points",["$","svg",null,{"className":"ux-ico","viewBox":"0 0 24 24","style":"$undefined","aria-hidden":true,"role":"$undefined","aria-label":"$undefined","focusable":"false","dangerouslySetInnerHTML":{"__html":"<path d=\"m6 9 6 6 6-6\"/>"}}]]}],["$","div",null,{"className":"p9-ab","children":["Every finished quiz about a group adds ",["$","b",null,{"children":"1 point"}]," ","to that group's fandom, whoever plays it, guests and replays included. The board counts the ",["$","b",null,{"children":"last 7 days"}]," and updates every hour; the change is against the 7 days before. General K-pop quizzes and blindtests do not count. Your main group, set in Settings, is the fandom pinned under the board."]}]]}],["$","details",null,{"className":"p9-acc","children":[["$","summary",null,{"children":["Player points",["$","svg",null,{"className":"ux-ico","viewBox":"0 0 24 24","style":"$undefined","aria-hidden":true,"role":"$undefined","aria-label":"$undefined","focusable":"false","dangerouslySetInnerHTML":{"__html":"<path d=\"m6 9 6 6 6-6\"/>"}}]]}],["$","div",null,{"className":"p9-ab","children":["Players are ranked by ",["$","b",null,{"children":"all-time XP"}],", the XP that sets your level on your passport. Finishing a quiz for the first time earns ",["$","b",null,{"children":"10 XP"}],", ",["$","b",null,{"children":"5 more"}]," at 70% or better and ",["$","b",null,{"children":"15 more"}]," for a perfect score (replays earn none). Your daily streak, publishing quizzes and plays of your quizzes by other fans earn XP too."]}]]}],["$","details",null,{"className":"p9-acc","children":[["$","summary",null,{"children":["Creator points",["$","svg",null,{"className":"ux-ico","viewBox":"0 0 24 24","style":"$undefined","aria-hidden":true,"role":"$undefined","aria-label":"$undefined","focusable":"false","dangerouslySetInnerHTML":{"__html":"<path d=\"m6 9 6 6 6-6\"/>"}}]]}],["$","div",null,{"className":"p9-ab","children":["Creators are ranked by the ",["$","b",null,{"children":"plays their quizzes have received"}]," since they joined: every finished play counts, guests included.",[" ",["$","b",null,{"children":"This week"}]," counts the plays of the quizzes they published in the last 7 days."],[" ",["$","b",null,{"children":"Rising"}]," counts new followers in the last 7 days."]," ","Your pinned row is your all-time standing."]}]]}]]}]
