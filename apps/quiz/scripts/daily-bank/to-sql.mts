// Writes the SQL of a reviewed daily quiz lot (Mission U, owner 2026-10-15). The owner applies
// it himself, after his review. Nothing is written to the database here.
//
//   npx tsx scripts/daily-bank/to-sql.mts --lot 1 --reviewer Louis --reviewed 2026-10-17 <lot.json> [...]
//
// Output: docs/pending-migrations/daily-bank-2026-10-lot<N>.sql, and its rollback. Rows are
// inserted with status 'verified', their scheduled_date written in the SQL (so the publish date
// is the reviewed one), group_id resolved from the slug (null for a quiz about several groups),
// and verification_notes listing the sources and the review. Lot 1 also clears the date of the
// leftover rows dated 2029 and later, so the rotation pulls them before the lot's dated rows
// and the lot starts on its first date (see the PR for the rotation rule).

import { writeFileSync } from 'node:fs';
import { resolve } from 'node:path';

import { loadLots, readClient } from './lib.mts';

const arg = (name: string): string | null => {
  const i = process.argv.indexOf(name);
  return i > 0 ? process.argv[i + 1] ?? null : null;
};
const sqlText = (s: string): string => `'${s.replace(/'/g, "''")}'`;

async function main(): Promise<void> {
  const lotN = arg('--lot');
  const reviewer = arg('--reviewer');
  const reviewed = arg('--reviewed');
  const files = process.argv.slice(2).filter((a) => a.endsWith('.json'));
  if (!lotN || files.length === 0) throw new Error('usage: to-sql.mts --lot N [--reviewer NAME --reviewed YYYY-MM-DD] <lot.json> [...]');

  const db = readClient();
  const { data: groups, error } = await db.from('groups').select('id, slug');
  if (error) throw new Error(error.message);
  const idOf = new Map(((groups ?? []) as Array<{ id: number; slug: string }>).map((g) => [g.slug, g.id]));

  const lot = loadLots(files).sort((a, b) => a.scheduled_date.localeCompare(b.scheduled_date));
  const review = reviewer && reviewed
    ? `Drafted with AI assistance, checked by ${reviewer} on ${reviewed}.`
    : 'Drafted with AI assistance, checked by {REVIEWER} on {REVIEW_DATE}.';

  const values = lot.map((q) => {
    const gid = q.group_slug ? idOf.get(q.group_slug) : null;
    if (q.group_slug && gid == null) throw new Error(`unknown group slug ${q.group_slug}`);
    const sources = [...new Set([...(q.sources ?? []), ...q.questions.map((x) => x.source)])];
    const notes = `Sources: ${sources.join(' ; ')}. ${review}`;
    const questions = JSON.stringify(q.questions);
    return `  (${sqlText(q.title)}, ${sqlText(q.description)}, ${gid ?? 'null'}, ${sqlText(q.quiz_type)}, ${sqlText(q.difficulty)}, ${sqlText(q.category)}, ${sqlText(questions)}::jsonb, ${sqlText(q.scheduled_date)}::date, 'verified', now(), ${sqlText(notes)})`;
  });

  const first = lot[0]!.scheduled_date;
  const last = lot.at(-1)!.scheduled_date;
  const titles = lot.map((q) => sqlText(q.title)).join(', ');
  const header = `-- Daily quiz bank, lot ${lotN}: ${lot.length} quizzes for ${first} to ${last} (Mission U, owner 2026-10-15).
-- OWNER-GATED: apply only after the review of this lot (every title and 25% of the questions,
-- plus everything lint-lot.mts flagged). Generated by apps/quiz/scripts/daily-bank/to-sql.mts.
-- Rollback: daily-bank-2026-10-lot${lotN}-rollback.sql (removes only rows of this lot not yet published).
${review.includes('{') ? '-- REVIEW NOT RECORDED: replace {REVIEWER} and {REVIEW_DATE} below after the review.\n' : ''}
begin;
`;
  const pin = lotN === '1' ? `
-- The rotation (lib/ux-v1/p1/qotd-rotation.ts, pickBankEntryForDate) fills a day with no row of
-- its own by pulling, in order: overdue rows, rows with no date, then future rows by date. Left
-- dated 2029 and later, the old open rows would be pulled AFTER this lot's rows and shift every
-- date of the lot. Without a date they are pulled first, and the lot keeps its dates.
update public.quiz_bank set scheduled_date = null, updated_at = now()
where status in ('verified', 'scheduled') and scheduled_date >= '2029-01-01';
` : '';
  const sql = `${header}${pin}
insert into public.quiz_bank (title, description, group_id, quiz_type, difficulty, category, questions, scheduled_date, status, verified_at, verification_notes)
values
${values.join(',\n')};

-- Check: one row per date, no clash with a row already scheduled on these dates.
select scheduled_date, count(*) from public.quiz_bank
where scheduled_date between ${sqlText(first)} and ${sqlText(last)} and status in ('verified', 'scheduled')
group by scheduled_date having count(*) > 1;

commit;
`;
  const rollback = `-- Rollback of daily-bank-2026-10-lot${lotN}.sql: removes the rows of this lot that were not
-- published yet (a published row is already a live quiz page; it stays).
delete from public.quiz_bank
where title in (${titles}) and status in ('verified', 'scheduled') and published_quiz_id is null;
`;
  const out = resolve(new URL('.', import.meta.url).pathname, '../../../../docs/pending-migrations');
  writeFileSync(resolve(out, `daily-bank-2026-10-lot${lotN}.sql`), sql);
  writeFileSync(resolve(out, `daily-bank-2026-10-lot${lotN}-rollback.sql`), rollback);
  console.log(`wrote daily-bank-2026-10-lot${lotN}.sql (${lot.length} rows) and its rollback`);
}

main().catch((e) => { console.error(e); process.exit(2); });
