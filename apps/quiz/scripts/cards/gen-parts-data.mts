// Bunnyverse Cards lot 7: writes docs/design/cards/data/lot7/parts.json and SUMMARY.md, the public data of 118 (a group photo in 2 or 3
// cards), from the thumbnail checks kept OUTSIDE the repository (they are never committed; the thumbnails are deleted once read).
//   tsx scripts/cards/gen-parts-data.mts --index <private index.json> --verdicts <private verdicts.jsonl> [--checks <private checks.jsonl>]
// index.json: [{ id, page, w, h, fx, fy }, ...] (the group photos of lots 3 and 6 that are not out); verdicts.jsonl: one first look per id;
// checks.jsonl: one second look per id and window ({ id, parts, cuts, unclear }). The output holds geometry, counts and the rule's lines
// only: no name, no age, no date of birth.
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';

import { countsOf, partsEntry } from '../../src/lib/cards/parts-data';

import { REPO, arg, outsideRepo } from './commons-io.mts';

import type { PartsItem, PrivateVerdict, WindowCheck } from '../../src/lib/cards/parts-data';

const need = (name: string): string => {
  const v = arg(name);
  if (!v) throw new Error(`--${name} <file> is required`);
  if (!outsideRepo(v)) throw new Error(`--${name}: the private checks stay outside the repository`);
  return v;
};
const lines = (f: string): Array<Record<string, unknown>> => readFileSync(f, 'utf8').split('\n').filter((l) => l.trim()).map((l) => JSON.parse(l));

const items = JSON.parse(readFileSync(need('index'), 'utf8')) as Array<PartsItem & { id: string }>;
const verdicts = new Map<string, PrivateVerdict>();
for (const v of lines(need('verdicts'))) verdicts.set(String(v.id), v as PrivateVerdict);
const checks = new Map<string, WindowCheck[]>();
const checksFile = arg('checks');
if (checksFile) {
  if (!outsideRepo(checksFile)) throw new Error('--checks: the private checks stay outside the repository');
  for (const c of lines(checksFile)) {
    const list = checks.get(String(c.id)) ?? [];
    list.push({ parts: c.parts as 2 | 3, cuts: c.cuts === true, ...(c.unclear === true ? { unclear: true } : {}) });
    checks.set(String(c.id), list);
  }
}

const missing = items.filter((it) => !verdicts.has(it.id)).map((it) => it.id);
const entries = items
  .map((it) => partsEntry({ page: it.page, w: it.w, h: it.h, fx: it.fx, fy: it.fy }, verdicts.get(it.id), checks.get(it.id) ?? []))
  .sort((a, b) => (a.page < b.page ? -1 : a.page > b.page ? 1 : 0));
const counts = countsOf(entries);

const out = path.join(REPO, 'docs/design/cards/data/lot7');
mkdirSync(out, { recursive: true });
const checkedOn = arg('day') ?? '2026-11-17';
writeFileSync(path.join(out, 'parts.json'), `${JSON.stringify({
  checked_on: checkedOn,
  rule: 'lot 7 (integrator, 2026-11-17): a group photo gives 2 cards (11:8.5) when that window keeps every head of the people the photo shows whole, else 3 cards (16.5:8.5) when that window does, else it waits for the owner (To review, 3 proposed); without a usable thumbnail the ratio decides; a thumbnail that seems to show a person under 18 rejects the photo (lot 6 limit). Geometry only: no name, no age.',
  sources: 'Wikimedia Commons 400 px thumbnails, read on the day above and deleted once read; apps/quiz/src/lib/cards/parts-rule.ts and parts-data.ts',
  photos: entries,
}, null, 1)}\n`);
writeFileSync(path.join(out, 'SUMMARY.md'), [
  '# Lot 7, group photos in 2 or 3 cards: summary',
  '',
  `Checked on ${checkedOn}. Generated by apps/quiz/scripts/cards/gen-parts-data.mts from the private thumbnail checks (deleted once read).`,
  'Geometry and counts only: nothing about anyone.',
  '',
  `- Group photos of lots 3 and 6 that can become cards (not out): ${counts.photos}.`,
  `- 2 cards: ${counts.two}. 3 cards: ${counts.three}. To review (someone would be cut even in 3, or the ratio alone cannot settle it): ${counts.review}.`,
  `- Rejected (the thumbnail seems to show a person under 18): ${counts.rejected}.`,
  `- Focal point moved so the window keeps everyone: ${counts.moved}.`,
  `- Decided by the ratio (no usable thumbnail): ${counts.byRatio}. Second look overruled the geometry: ${counts.byCheck}.`,
  '',
].join('\n'));
console.log(JSON.stringify(counts), missing.length ? `no first look for ${missing.length} photos (ratio)` : '');
