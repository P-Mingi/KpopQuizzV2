/**
 * Run O1 (Manhwa label on quiz cards): writes src/lib/anime/series-types.generated.ts, the map of series slug to `series.type`
 * that the anime quiz card reads (a card names its series by slug only). The map comes from docs/anime/data/series/*.json and
 * from nothing else, so a series added to the data is picked up by running this script again; src/lib/anime/series-types.test.ts
 * fails while the generated file is behind the data.
 *
 * Run from apps/quiz:  npx tsx scripts/gen-series-types.mts          (writes the file)
 *                      npx tsx scripts/gen-series-types.mts --check  (exit 1 when the file is behind the data)
 */
import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const DATA = join(process.cwd(), '../../docs/anime/data/series');
const OUT = join(process.cwd(), 'src/lib/anime/series-types.generated.ts');

export function render(types: Readonly<Record<string, string>>): string {
  const rows = Object.keys(types).sort().map((slug) => `  '${slug}': '${types[slug]}',`).join('\n');
  return `// GENERATED by scripts/gen-series-types.mts from docs/anime/data/series/*.json. Do not edit by hand: run the script again.
// The \`series.type\` of each series, by group slug (a quiz card names its series by slug only). src/lib/anime/series-types.test.ts holds this equal to the data.

export const SERIES_TYPE_BY_SLUG: Readonly<Record<string, string>> = {
${rows}
};
`;
}

const types: Record<string, string> = {};
for (const f of readdirSync(DATA).filter((n) => n.endsWith('.json')).sort()) {
  const d = JSON.parse(readFileSync(join(DATA, f), 'utf8')) as { group: { slug: string }; series: { type?: string } };
  if (typeof d.series.type === 'string') types[d.group.slug] = d.series.type;
}
const text = render(types);
if (process.argv.includes('--check')) {
  if (readFileSync(OUT, 'utf8') !== text) { console.error('series-types.generated.ts is behind docs/anime/data/series: run scripts/gen-series-types.mts'); process.exit(1); }
} else writeFileSync(OUT, text);
